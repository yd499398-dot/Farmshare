# Frontend (Vercel)
VITE_API_URL=https://YOUR-RENDER-SERVICE.onrender.com

# Backend (Render)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/farmshare?retryWrites=true&w=majority
MONGODB_DB_NAME=farmshare
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=https://YOUR-VERCEL-DOMAIN.vercel.app,http://localhost:5173

# Email (Render free plan blocks SMTP, so use Brevo HTTPS API)
BREVO_API_KEY=xkeysib-your-brevo-api-key
# Optional (only with a verified domain): RESEND_API_KEY + RESEND_FROM
# Gmail SMTP fallback - only works on paid Render plans / local. NEVER commit these values
GMAIL_USER=yourgmail@gmail.com
GMAIL_APP_PASS=your-16-character-app-password
EMAIL_FROM=FarmShare <yourgmail@gmail.com>

# Optional admin allow-list (comma separated)
ADMIN_EMAILS=your-admin-email@gmail.com
OWNER_EMAILS=your-owner-email@gmail.com
PORT=10000

# Testing only - NEVER enable in production
# DEV_OTP_BYPASS=true
